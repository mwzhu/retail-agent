{
  "name": "sierra-outfitters-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "demo": "SIERRA_DEMO_MODE=1 npm run dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "review:agent": "tsx scripts/run-agent-review.ts",
    "compare:agent": "tsx scripts/run-agent-comparison.ts",
    "test": "vitest run",
    "verify": "npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.1",
    "openai": "^7.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
